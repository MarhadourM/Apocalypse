<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- L'ombre portée -->
    <item android:top="4dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Le corps du bouton (sa couleur sera remplacée par le Kotlin) -->
    <item android:bottom="4dp" android:right="2dp">
        <shape android:shape="rectangle">
            <!-- Couleur temporaire (Gris foncé) pour voir le bouton dans l'éditeur -->
            <solid android:color="#4A4A4A" />
            <!-- Bordure foncée -->
            <stroke android:width="2dp" android:color="#D2B48C" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Léger reflet en haut pour l'effet "bouton physique" -->
    <item android:bottom="6dp" android:right="4dp" android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>

</layer-list>
