<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item android:bottom="4dp" android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#D2B48C"
                android:centerColor="#F5E6CA"
                android:endColor="#D2B48C"
                android:type="linear" />

            <stroke
                android:width="1dp"
                android:color="#B08D57" />

            <corners android:radius="4dp" />

            <padding
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp" />
        </shape>
    </item>

</layer-list>