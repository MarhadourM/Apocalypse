<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".IntroGameView">


    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/background_menu"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/whiteOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B3FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/buttonPasserRegles"
        android:layout_width="152dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/paper_background"
        android:text="Passer Règles"
        android:textColor="#000000"
        android:visibility="gone"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="@+id/buttonRegleSuivante"
        app:layout_constraintStart_toStartOf="@+id/buttonRegleSuivante"
        app:layout_constraintTop_toBottomOf="@+id/buttonRegleSuivante" />

    <Button
        android:id="@+id/buttonRegleSuivante"
        android:layout_width="152dp"
        android:layout_height="48dp"
        android:layout_marginBottom="168dp"
        android:background="@drawable/paper_background"
        android:text="Regle Suivante"
        android:textColor="#000000"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.873"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="386dp"
        android:layout_height="121dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="284dp"
        android:layout_marginRight="24dp"
        android:background="@drawable/parchemin"
        android:fontFamily="@font/crimson_text"
        android:padding="3dp"
        android:text="Vous etes maintenant patrik et vous venez de sortir pour la dernière fois du Bunker-antiatomique  "
        android:textColor="#3E2723"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bgImage" />

    <ProgressBar
        android:id="@+id/progressBarVie"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="100dp"
        android:layout_height="12dp"
        android:layout_marginTop="52dp"
        android:max="90"
        android:min="0"
        android:progress="90"
        android:progressDrawable="@drawable/progress_vie"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progressBarSatiete"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="100dp"
        android:layout_height="12dp"
        android:layout_marginTop="10dp"
        android:max="90"
        android:min="0"
        android:progress="90"
        android:progressDrawable="@drawable/progress_satiete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarVie" />

    <ProgressBar
        android:id="@+id/progressBarHydra"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="100dp"
        android:layout_height="12dp"
        android:layout_marginTop="10dp"
        android:max="90"
        android:min="0"
        android:progress="90"
        android:progressDrawable="@drawable/progress_hydra"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarSatiete" />


</androidx.constraintlayout.widget.ConstraintLayout>