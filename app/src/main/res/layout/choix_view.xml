<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvLeverSoleil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Lever du soleil"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvJour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Jour 1"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/tvLeverSoleil"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@+id/tvLeverSoleil"
        app:layout_constraintTop_toBottomOf="@+id/tvLeverSoleil" />

    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="Choisir un carte"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="@+id/tvJour"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@+id/tvJour"
        app:layout_constraintTop_toBottomOf="@+id/tvJour" />

    <ImageView
        android:id="@+id/ivCarteBonus1"
        android:layout_width="179dp"
        android:layout_height="261dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="85dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvInstruction"
        app:srcCompat="@drawable/cartbonus" />

    <ImageView
        android:id="@+id/ivCarteBonus2"
        android:layout_width="179dp"
        android:layout_height="261dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="85dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivCarteBonus1"
        app:layout_constraintTop_toBottomOf="@+id/tvInstruction"
        app:srcCompat="@drawable/cartbonus" />

    <TextView
        android:id="@+id/tvPtsVie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:text="Vie"
        app:layout_constraintEnd_toStartOf="@+id/tvJour"
        app:layout_constraintHorizontal_bias="0.252"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvPtsHydra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Hydratation"
        app:layout_constraintEnd_toStartOf="@+id/tvJour"
        app:layout_constraintHorizontal_bias="0.252"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPtsVie" />

    <TextView
        android:id="@+id/tvPtsSasiete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nourriture"
        app:layout_constraintEnd_toStartOf="@+id/tvJour"
        app:layout_constraintHorizontal_bias="0.233"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPtsHydra" />

</androidx.constraintlayout.widget.ConstraintLayout>