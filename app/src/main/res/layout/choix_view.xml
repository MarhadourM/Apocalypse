<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">



    <ProgressBar
        android:id="@+id/progressBarVie2"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="140dp"
        android:layout_height="13dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="156dp"
        android:background="@drawable/progress_background"
        android:max="120"
        android:min="0"
        android:progress="120"
        android:progressDrawable="@drawable/progress_vie"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/coeur2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="140dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/coeur" />

    <ProgressBar
        android:id="@+id/progressBarSatiete2"
        style="?android:attr/progressBarStyleHorizontal"
        android:background="@drawable/progress_background"
        android:layout_width="141dp"
        android:layout_height="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:max="120"
        android:min="0"
        android:progress="120"
        android:progressDrawable="@drawable/progress_satiete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarVie2" />


    <ImageView
        android:id="@+id/conserve2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarVie2"
        app:srcCompat="@drawable/conserve" />

    <ProgressBar
        android:id="@+id/progressBarHydra2"
        style="?android:attr/progressBarStyleHorizontal"
        android:background="@drawable/progress_background"
        android:layout_width="140dp"
        android:layout_height="13dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:max="120"
        android:min="0"
        android:progress="120"
        android:progressDrawable="@drawable/progress_hydra"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarSatiete2" />

    <ImageView
        android:id="@+id/goutte2"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarSatiete2"
        app:srcCompat="@drawable/goutte" />

    <TextView
        android:id="@+id/tvLeverSoleil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:text="Lever du soleil"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.512"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvJour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Jour 1"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/tvLeverSoleil"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@+id/tvLeverSoleil"
        app:layout_constraintTop_toBottomOf="@+id/tvLeverSoleil" />

    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="Choisir une carte"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="@+id/tvJour"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@+id/tvJour"
        app:layout_constraintTop_toBottomOf="@+id/tvJour" />

    <ImageView
        android:id="@+id/ivCarteBonus1"
        android:layout_width="179dp"
        android:layout_height="261dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="85dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvInstruction"
        app:srcCompat="@drawable/cartbonus" />

    <ImageView
        android:id="@+id/ivCarteBonus2"
        android:layout_width="179dp"
        android:layout_height="261dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="85dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivCarteBonus1"
        app:layout_constraintTop_toBottomOf="@+id/tvInstruction"
        app:srcCompat="@drawable/cartbonus" />

    <ImageView
        android:id="@+id/rarete1"
        android:layout_width="165dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="@+id/ivCarteBonus1"
        app:layout_constraintStart_toStartOf="@+id/ivCarteBonus1"
        app:layout_constraintTop_toBottomOf="@+id/ivCarteBonus1"
        app:srcCompat="@drawable/commun" />

    <ImageView
        android:id="@+id/rarete2"
        android:layout_width="165dp"
        android:layout_height="20dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="@+id/ivCarteBonus2"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/ivCarteBonus2"
        app:layout_constraintTop_toBottomOf="@+id/ivCarteBonus2"
        app:srcCompat="@drawable/commun" />

</androidx.constraintlayout.widget.ConstraintLayout>