<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/actionview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/progressBarVie3"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="140dp"
        android:layout_height="13dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="156dp"
        android:background="@drawable/progress_background"
        android:max="120"
        android:min="0"
        android:progress="120"
        android:progressDrawable="@drawable/progress_vie"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progressBarSatiete3"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="141dp"
        android:layout_height="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/progress_background"
        android:max="120"
        android:min="0"
        android:progress="120"
        android:progressDrawable="@drawable/progress_satiete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarVie3" />


    <ImageView
        android:id="@+id/conserve3"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarVie3"
        app:srcCompat="@drawable/conserve" />

    <ProgressBar
        android:id="@+id/progressBarHydra3"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="140dp"
        android:layout_height="13dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/progress_background"
        android:max="120"
        android:min="0"
        android:progress="120"
        android:progressDrawable="@drawable/progress_hydra"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarVie3" />
    <ImageView
        android:id="@+id/goutte3"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarSatiete3"
        app:srcCompat="@drawable/goutte" />

    <ImageView
        android:id="@+id/coeur3"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="140dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/coeur" />

    <Button
        android:id="@+id/buttonLancerDes"
        android:layout_width="169dp"
        android:layout_height="97dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="250dp"
        android:text="Lancer les Dés"
        android:textSize="24sp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDescriptionAction" />

    <TextView
        android:id="@+id/tvChoixCarteBonus"
        android:layout_width="220dp"
        android:layout_height="63dp"
        android:layout_marginTop="104dp"
        android:text="Vous avez choisi "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.984"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvDescriptionAction"
        android:layout_width="364dp"
        android:layout_height="94dp"
        android:layout_marginTop="101dp"
        android:text="Description Action"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.425"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvChoixCarteBonus" />

    <TextView
        android:id="@+id/tvCible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="Cible de l'action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDescriptionAction" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="36dp"
        android:text="Bonus"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@+id/tvCible"
        app:layout_constraintTop_toTopOf="@+id/tvCible" />

    <TextView
        android:id="@+id/tvMalusAction"
        android:layout_width="72dp"
        android:layout_height="31dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="32dp"
        android:text="Malus"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/tvCible"
        app:layout_constraintTop_toTopOf="@+id/tvCible" />

    <TextView
        android:id="@+id/tvModificateurBonus"
        android:layout_width="144dp"
        android:layout_height="78dp"
        android:layout_marginTop="22dp"
        android:text="TextView"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/textView"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <TextView
        android:id="@+id/tvModificateurMalus"
        android:layout_width="144dp"
        android:layout_height="78dp"
        android:layout_marginTop="22dp"
        android:text="TextView"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/tvMalusAction"
        app:layout_constraintStart_toStartOf="@+id/tvMalusAction"
        app:layout_constraintTop_toBottomOf="@+id/tvMalusAction" />
</androidx.constraintlayout.widget.ConstraintLayout>