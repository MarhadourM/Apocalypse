<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/actionview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvPtsVie2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="28dp"
        android:text="Vie"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvPtsHydra2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Hydratation"
        app:layout_constraintStart_toStartOf="@+id/tvPtsVie2"
        app:layout_constraintTop_toBottomOf="@+id/tvPtsVie2" />

    <TextView
        android:id="@+id/tvPtsSasiete2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Nourriture"
        app:layout_constraintStart_toStartOf="@+id/tvPtsHydra2"
        app:layout_constraintTop_toBottomOf="@+id/tvPtsHydra2" />

    <Button
        android:id="@+id/buttonLancerDes"
        android:layout_width="169dp"
        android:layout_height="97dp"
        android:layout_marginStart="116dp"
        android:layout_marginTop="280dp"
        android:text="Lancer les Dés"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDescriptionAction" />

    <TextView
        android:id="@+id/tvChoixCarteBonus"
        android:layout_width="220dp"
        android:layout_height="63dp"
        android:layout_marginTop="28dp"
        android:text="Vous avez choisi "
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.916"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvDescriptionAction"
        android:layout_width="364dp"
        android:layout_height="94dp"
        android:layout_marginTop="70dp"
        android:text="Description Action"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.489"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPtsSasiete2" />

    <TextView
        android:id="@+id/tvCible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="Cible de l'action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDescriptionAction" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="36dp"
        android:text="Bonus"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@+id/tvCible"
        app:layout_constraintTop_toTopOf="@+id/tvCible" />

    <TextView
        android:id="@+id/tvMalusAction"
        android:layout_width="72dp"
        android:layout_height="31dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="32dp"
        android:text="Malus"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/tvCible"
        app:layout_constraintTop_toTopOf="@+id/tvCible" />

    <TextView
        android:id="@+id/tvModificateurBonus"
        android:layout_width="144dp"
        android:layout_height="78dp"
        android:layout_marginTop="22dp"
        android:text="TextView"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/textView"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <TextView
        android:id="@+id/tvModificateurMalus"
        android:layout_width="144dp"
        android:layout_height="78dp"
        android:layout_marginTop="22dp"
        android:text="TextView"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/tvMalusAction"
        app:layout_constraintStart_toStartOf="@+id/tvMalusAction"
        app:layout_constraintTop_toBottomOf="@+id/tvMalusAction" />
</androidx.constraintlayout.widget.ConstraintLayout>